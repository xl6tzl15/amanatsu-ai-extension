{
  "note": "Single source for every HTTP endpoint. GET /api/v1/schema, openapi.yaml (gen_openapi.py) and the MCP server's call_api all read this file; the build fails when it and the C# routes disagree.",
  "components": {
    "Error": { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"] },
    "Color": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "[r,g,b] or [r,g,b,a] in 0..1" },
    "Vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "Vector3Rate": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "Region": { "type": "string", "enum": ["face", "bust", "upper_body", "waist", "legs", "full"] },
    "View": { "type": "string", "enum": ["front", "back", "left", "right", "top", "bottom"] },
    "KitRegion": { "type": "string", "enum": ["outline", "eyes", "brows", "nose", "mouth", "hair"] },
    "CardFile": { "type": "string", "pattern": "^[^/\\\\]+[.]png$", "description": "file name in UserData/chara/female" },
    "BooleanState": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "required": ["enabled"] },
    "CharacterTarget": {
      "type": "object",
      "properties": { "uniqueId": { "type": "integer" }, "listIndex": { "type": "integer", "minimum": 0 }, "name": { "type": "string" } },
      "description": "identify the character by one of uniqueId, listIndex or name"
    },
    "Operation": {
      "type": "object",
      "properties": { "path": { "type": "string", "description": "POST endpoint relative to /api/v1/" }, "body": { "type": "object" } },
      "required": ["path", "body"]
    }
  },
  "endpoints": [
    { "method": "GET", "path": "schema", "summary": "Every endpoint with its body (this list)" },
    { "method": "GET", "path": "state", "summary": "Scene and whether the character creator is ready" },
    { "method": "POST", "path": "navigate", "summary": "One step toward the target screen per call; repeat until done:true",
      "body": { "type": "object", "properties": { "target": { "type": "string", "enum": ["female-creator"] } }, "required": ["target"] } },
    { "method": "GET", "path": "logs", "summary": "Recent operation log entries",
      "query": { "limit": { "type": "integer", "minimum": 1, "default": 100 } } },

    { "method": "GET", "path": "ui/buttons", "summary": "Active Unity buttons" },
    { "method": "POST", "path": "ui/click", "summary": "Click a button from ui/buttons",
      "body": { "type": "object", "properties": { "id": { "type": "integer" } }, "required": ["id"] } },
    { "method": "GET", "path": "ui/toggles", "summary": "Active Unity toggles" },
    { "method": "POST", "path": "ui/toggle", "summary": "Set a toggle from ui/toggles",
      "body": { "type": "object", "properties": { "id": { "type": "integer" }, "value": { "type": "boolean" } }, "required": ["id", "value"] } },
    { "method": "GET", "path": "ui/input-sliders", "summary": "Maker numeric inputs with their on-screen Japanese label and order" },
    { "method": "POST", "path": "ui/input-slider", "summary": "Type into a maker numeric input through its real onEndEdit path",
      "body": { "type": "object", "properties": { "id": { "type": "integer" }, "text": { "type": "string" } }, "required": ["id", "text"] } },

    { "method": "GET", "path": "screenshot", "summary": "Current screen as base64 PNG" },
    { "method": "GET", "path": "camera/landmarks", "summary": "World-space skeleton positions and face bounds" },
    { "method": "POST", "path": "camera/frame", "summary": "Point the maker camera at a body region",
      "body": { "type": "object", "properties": { "region": { "$ref": "Region" }, "view": { "$ref": "View" } }, "required": ["region"] } },
    { "method": "POST", "path": "capture", "summary": "Frame, wait for the render and return framing metadata with image.pngBase64; optional expression and pose apply only for the shot",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "Region" }, "view": { "$ref": "View" },
        "expression": { "type": "object", "properties": { "eyebrow": { "type": "integer", "minimum": 0 }, "eyes": { "type": "integer", "minimum": 0 }, "mouth": { "type": "integer", "minimum": 0 } } },
        "pose": { "oneOf": [{ "type": "string" }, { "type": "integer" }], "description": "state name or index from creator/poses" } },
        "required": ["region"] } },

    { "method": "GET", "path": "self-shadow", "summary": "Self-shadow state (companion plugin)" },
    { "method": "POST", "path": "self-shadow", "summary": "Turn self-shadow on or off", "body": { "$ref": "BooleanState" } },
    { "method": "GET", "path": "slider-unlock", "summary": "Extended slider range state (companion plugin)" },
    { "method": "POST", "path": "slider-unlock", "summary": "Turn the extended slider range on or off", "body": { "$ref": "BooleanState" } },
    { "method": "GET", "path": "favorability", "summary": "Character parameter state" },
    { "method": "POST", "path": "favorability", "summary": "Change a character's favorability",
      "body": { "allOf": [{ "$ref": "CharacterTarget" }, { "type": "object", "properties": {
        "point": { "type": "integer" }, "delta": { "type": "integer" }, "level": { "type": "integer" }, "isMaxLevel": { "type": "boolean" } } }] } },
    { "method": "GET", "path": "character-parameters", "summary": "Character parameter state" },
    { "method": "POST", "path": "character-parameters", "summary": "Change a character parameter, gauge stage, scene unlocks or realtime outfit",
      "body": { "allOf": [{ "$ref": "CharacterTarget" }, { "type": "object", "properties": {
        "parameter": { "type": "string", "enum": ["favorability", "inclusiveness", "proactivity", "curiosity"] },
        "point": { "type": "integer" }, "delta": { "type": "integer" }, "level": { "type": "integer" }, "isMaxLevel": { "type": "boolean" },
        "gaugeStageIndex": { "type": "integer", "minimum": 0, "maximum": 11 }, "gaugeStage": { "type": "integer", "minimum": 0, "maximum": 6 },
        "nightEventCount": { "type": "integer" }, "hCount": { "type": "integer" }, "massageCount": { "type": "integer" },
        "latePoint": { "type": "integer" }, "cost": { "type": "integer" }, "unlockScenes": { "type": "boolean" },
        "coordinateType": {}, "clothesPart": {}, "clothesState": {}, "accessorySlot": { "type": "integer" },
        "accessoryVisible": { "type": "boolean" }, "allAccessoriesVisible": { "type": "boolean" } } }] } },
    { "method": "GET", "path": "realtime-outfit", "summary": "Character state including realtime outfit data" },
    { "method": "POST", "path": "realtime-outfit", "summary": "Change a character's current outfit state",
      "body": { "allOf": [{ "$ref": "CharacterTarget" }, { "type": "object", "properties": {
        "coordinateType": { "oneOf": [{ "type": "integer", "enum": [0, 1] }, { "type": "string", "enum": ["swimsuit", "afterBath"] }] },
        "clothesPart": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 7 }, { "type": "string", "enum": ["top", "bottom", "bra", "shorts", "gloves", "pantyhose", "socks", "shoes"] }] },
        "clothesState": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 2 }, { "type": "string", "enum": ["clothing", "halfUndress", "naked"] }] },
        "accessorySlot": { "type": "integer", "minimum": 0 }, "accessoryVisible": { "type": "boolean" }, "allAccessoriesVisible": { "type": "boolean" } } }] } },

    { "method": "GET", "path": "character", "summary": "Current character shape arrays and part IDs" },
    { "method": "POST", "path": "character/shape", "summary": "Set one shape value (creator/shapes sets many at once)",
      "body": { "type": "object", "properties": { "region": { "type": "string", "enum": ["body", "face"] }, "index": { "type": "integer", "minimum": 0 }, "value": { "type": "number", "minimum": -5, "maximum": 5 } }, "required": ["region", "index", "value"] } },
    { "method": "POST", "path": "character/choice", "summary": "Choose a head, hair or clothes part by catalog id",
      "body": { "type": "object", "properties": {
        "kind": { "type": "string", "enum": ["head", "hair_back", "hair_front", "hair_side", "hair_option", "clothes_top", "clothes_bot", "clothes_bra", "clothes_shorts", "clothes_gloves", "clothes_panst", "clothes_socks", "clothes_shoes", "clothes_add_arm", "clothes_add_leg", "clothes_add_other"] },
        "id": { "type": "integer" } }, "required": ["kind", "id"] } },
    { "method": "GET", "path": "catalog", "summary": "Sorted choices of a game category (bo_head, bo_hair_f, co_bot, ao_*, mt_* ...)",
      "query": { "category": { "type": "string", "required": true } } },
    { "method": "GET", "path": "cards", "summary": "Character cards in UserData/chara/female" },
    { "method": "GET", "path": "card", "summary": "Read a saved card without loading it",
      "query": { "file": { "type": "string", "required": true, "description": "relative png path from cards" } } },

    { "method": "GET", "path": "creator/details", "summary": "Profile, named shape indices, colors, coordinate parts, accessory slots and tabs" },
    { "method": "GET", "path": "creator/diagnostics", "summary": "Loaded Human objects" },
    { "method": "GET", "path": "creator/shape-guide", "summary": "Every face/body slider in maker order with its Japanese label and what raising or lowering it does" },
    { "method": "POST", "path": "creator/shapes", "summary": "Set many face/body shape values at once (validated as a whole, one model refresh)",
      "body": { "type": "object", "properties": {
        "face": { "type": "object", "additionalProperties": { "type": "number", "minimum": -5, "maximum": 5 }, "description": "name or index: value" },
        "body": { "type": "object", "additionalProperties": { "type": "number", "minimum": -5, "maximum": 5 }, "description": "name or index: value" } } } },
    { "method": "GET", "path": "creator/params", "summary": "Detailed maker values with increase/decrease notes for face and body" },
    { "method": "POST", "path": "creator/params", "summary": "Set detailed maker values (all validated first; rolled back if one fails); without values it reads with the given selectors",
      "body": { "type": "object", "properties": {
        "values": { "type": "object", "description": "name: value, names from GET creator/params" },
        "eye": { "type": "integer", "enum": [0, 1] }, "highlight": { "type": "integer", "minimum": 0 },
        "part": { "type": "integer", "minimum": 0, "maximum": 3, "description": "hair 0 back, 1 front, 2 side, 3 option" },
        "slot": { "type": "integer", "minimum": 0, "description": "clothes or accessory slot" },
        "channel": { "type": "integer", "minimum": 0, "description": "clothes colour channel" },
        "foot": { "type": "boolean", "description": "toenails" } } } },
    { "method": "GET", "path": "creator/freeze", "summary": "Whether blinking, eye movement and body motion run" },
    { "method": "POST", "path": "creator/freeze", "summary": "Stop (false) or resume (true) blinking, eye movement and body motion; resuming restores the state from before the stop",
      "body": { "type": "object", "properties": { "blink": { "type": "boolean" }, "eyeMovement": { "type": "boolean" }, "motion": { "type": "boolean" } } } },
    { "method": "GET", "path": "creator/face-parts", "summary": "Eyebrow, eyeline, eyelid, eye white, nose, lip line, detail, iris and pupil ids" },
    { "method": "POST", "path": "creator/face-parts", "summary": "Change face part ids",
      "body": { "type": "object", "properties": {
        "eyebrow": { "type": "integer" }, "eyelineUp": { "type": "integer" }, "eyelineDown": { "type": "integer" }, "eyelid": { "type": "integer" },
        "white": { "type": "integer" }, "nose": { "type": "integer" }, "lipLine": { "type": "integer" }, "detail": { "type": "integer" },
        "eye": { "type": "integer" }, "pupil": { "type": "integer" }, "eyePreset": { "type": "integer" }, "eyePresetFlags": { "type": "integer", "default": 3 },
        "foregroundEyes": { "type": "integer", "minimum": 0, "maximum": 2 }, "foregroundEyebrow": { "type": "integer", "minimum": 0, "maximum": 2 } } } },
    { "method": "GET", "path": "creator/makeup", "summary": "Eyeshadow, cheek, lip and eye colour makeup" },
    { "method": "POST", "path": "creator/makeup", "summary": "Change makeup ids and colours",
      "body": { "type": "object", "properties": {
        "eyeshadowId": { "type": "integer" }, "eyeshadowColor": { "$ref": "Color" }, "cheekId": { "type": "integer" }, "cheekColor": { "$ref": "Color" },
        "cheekHighlightColor": { "$ref": "Color" }, "lipId": { "type": "integer" }, "lipColor": { "$ref": "Color" }, "lipHighlightColor": { "$ref": "Color" },
        "eyeGradColor": { "$ref": "Color" }, "eyeHighlightColor": { "$ref": "Color" } } } },
    { "method": "GET", "path": "creator/eye-lines", "summary": "Eyeline and eyelid colours and eyeline weight" },
    { "method": "POST", "path": "creator/eye-lines", "summary": "Change eyeline and eyelid colours and eyeline weight",
      "body": { "type": "object", "properties": { "eyelineColor": { "$ref": "Color" }, "eyelidColor": { "$ref": "Color" }, "eyelineUpWeight": { "type": "number" } } } },
    { "method": "POST", "path": "creator/color", "summary": "Set one hair, eye, eyebrow, clothes or accessory colour",
      "body": { "type": "object", "properties": {
        "target": { "type": "string", "enum": ["hair", "eye", "eyebrow", "clothes", "accessory"] },
        "slot": { "type": "integer", "minimum": 0 }, "channel": { "type": "integer", "minimum": 0 },
        "field": { "type": "string", "enum": ["base", "start", "end", "outline", "gloss", "shadow", "mesh", "inner"], "description": "hair only" },
        "color": { "$ref": "Color" } }, "required": ["target", "color"] } },
    { "method": "POST", "path": "creator/hair-colors", "summary": "Set hair colours on several hair slots at once (default all four)",
      "body": { "type": "object", "properties": {
        "slots": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "base": { "$ref": "Color" }, "start": { "$ref": "Color" }, "end": { "$ref": "Color" }, "outline": { "$ref": "Color" },
        "gloss": { "$ref": "Color" }, "shadow": { "$ref": "Color" }, "mesh": { "$ref": "Color" }, "inner": { "$ref": "Color" },
        "useMesh": { "type": "boolean" }, "useInner": { "type": "boolean" } } } },
    { "method": "POST", "path": "creator/hair-flags", "summary": "Turn a hair slot's mesh and inner colours on or off",
      "body": { "type": "object", "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 3 }, "useMesh": { "type": "boolean" }, "useInner": { "type": "boolean" } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/hair-bundle", "summary": "Normalized move/rotate rates of one movable bundle of this hairstyle",
      "body": { "type": "object", "properties": {
        "part": { "type": "integer", "minimum": 0, "maximum": 3 }, "index": { "type": "integer", "minimum": 0 },
        "moveRate": { "$ref": "Vector3Rate" }, "rotRate": { "$ref": "Vector3Rate" } }, "required": ["part", "index"] } },
    { "method": "POST", "path": "creator/skin", "summary": "Skin colour, tan lines, mole and skin shine",
      "body": { "type": "object", "properties": {
        "mainColor": { "$ref": "Color" }, "sunburnUpId": { "type": "integer", "minimum": 0 }, "sunburnDownId": { "type": "integer", "minimum": 0 },
        "moleId": { "type": "integer", "minimum": 0 }, "shineId": { "type": "integer", "minimum": 0 }, "shinePower": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    { "method": "POST", "path": "creator/profile", "summary": "Name, birthday, personality, voice pitch and blood type",
      "body": { "type": "object", "properties": {
        "lastname": { "type": "string", "minLength": 1, "maxLength": 20 }, "firstname": { "type": "string", "minLength": 1, "maxLength": 20 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 20 },
        "birthMonth": { "type": "integer", "minimum": 1, "maximum": 12 }, "birthDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "personality": { "type": "integer", "description": "from creator/personalities" }, "voiceRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "bloodType": { "type": "integer", "minimum": 0, "maximum": 3 } }, "required": ["lastname", "firstname", "nickname"] } },
    { "method": "GET", "path": "creator/personalities", "summary": "Personality ids the maker offers" },
    { "method": "GET", "path": "creator/poses", "summary": "Maker poses usable by capture" },
    { "method": "POST", "path": "creator/accessory", "summary": "Put an accessory in a slot (parent defaults to the accessory's own)",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "category": { "type": "string", "pattern": "^ao_" },
        "id": { "type": "integer", "minimum": 0 }, "parent": { "type": "integer", "minimum": 0 } }, "required": ["slot", "category", "id"] } },
    { "method": "POST", "path": "creator/accessory-move", "summary": "Position, rotation and scale of an accessory's maker tab 01 or 02 (02 only for two-piece accessories)",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "tab": { "type": "integer", "enum": [1, 2], "default": 1 },
        "pos": { "$ref": "Vector3" }, "rot": { "$ref": "Vector3" }, "scl": { "$ref": "Vector3" }, "reset": { "type": "boolean" } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/accessory-clear", "summary": "Empty an accessory slot",
      "body": { "type": "object", "properties": { "slot": { "type": "integer", "minimum": 0 } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/clothes-pattern", "summary": "Pattern, pattern colour, gloss and metallic of one clothes colour channel",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "channel": { "type": "integer", "minimum": 0 }, "pattern": { "type": "integer", "minimum": 0 },
        "patternColor": { "$ref": "Color" }, "gloss": { "type": "number", "minimum": 0, "maximum": 1 }, "metallic": { "type": "number", "minimum": 0, "maximum": 1 } },
        "required": ["slot", "channel"] } },
    { "method": "POST", "path": "creator/coordinate", "summary": "Switch the outfit being edited",
      "body": { "type": "object", "properties": { "type": { "type": "integer", "enum": [0, 1], "description": "0 swimsuit, 1 after bath" } }, "required": ["type"] } },
    { "method": "POST", "path": "creator/coordinate-copy", "summary": "Copy hair, accessories, clothes or makeup from one outfit to another",
      "body": { "type": "object", "properties": {
        "from": { "type": "integer", "enum": [0, 1] }, "to": { "type": "integer", "enum": [0, 1] },
        "parts": { "type": "array", "items": { "type": "string", "enum": ["hair", "accessory", "clothes", "makeup"] } } }, "required": ["from", "to"] } },
    { "method": "GET", "path": "creator/camera", "summary": "Maker camera position, rotation, direction and field of view" },
    { "method": "POST", "path": "creator/camera", "summary": "Move the maker camera",
      "body": { "type": "object", "properties": {
        "position": { "$ref": "Vector3" }, "rotation": { "$ref": "Vector3" }, "direction": { "$ref": "Vector3" },
        "fov": { "type": "number", "minimum": 5, "maximum": 100 } } } },
    { "method": "POST", "path": "creator/reset", "summary": "Reset to the maker's initial character",
      "body": { "type": "object", "properties": { "keepProfile": { "type": "boolean" } } } },
    { "method": "GET", "path": "creator/export", "summary": "The whole character as import operations" },
    { "method": "POST", "path": "creator/import", "summary": "Run POST operations in order with one model refresh at the end",
      "body": { "type": "object", "properties": {
        "operations": { "type": "array", "items": { "$ref": "Operation" } }, "stopOnError": { "type": "boolean", "default": true } }, "required": ["operations"] } },

    { "method": "GET", "path": "creator/kits", "summary": "Saved part kits" },
    { "method": "POST", "path": "creator/kit-save", "summary": "Save one region of the current character as a kit",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "KitRegion" }, "name": { "type": "string" }, "description": { "type": "string" }, "overwrite": { "type": "boolean" } }, "required": ["region", "name"] } },
    { "method": "POST", "path": "creator/kit-from-card", "summary": "Save one region of a saved card as a kit",
      "body": { "type": "object", "properties": {
        "file": { "type": "string" }, "region": { "$ref": "KitRegion" }, "name": { "type": "string" }, "description": { "type": "string" },
        "coordinate": { "type": "integer", "minimum": 0 }, "overwrite": { "type": "boolean" } }, "required": ["file", "region", "name"] } },
    { "method": "POST", "path": "creator/kit-apply", "summary": "Apply a kit, optionally leaving out shapes, parts, colours or single fields",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "KitRegion" }, "name": { "type": "string" },
        "exclude": { "type": "array", "items": { "type": "string" }, "description": "shapes, parts, colors or field names" },
        "dryRun": { "type": "boolean" } }, "required": ["region", "name"] } },
    { "method": "POST", "path": "creator/kit-delete", "summary": "Delete a kit",
      "body": { "type": "object", "properties": { "region": { "$ref": "KitRegion" }, "name": { "type": "string" } }, "required": ["region", "name"] } },

    { "method": "GET", "path": "creator/files", "summary": "The maker's visible card list (open the native card UI first)" },
    { "method": "POST", "path": "creator/native-ui", "summary": "Press the maker's own save/load buttons",
      "body": { "type": "object", "properties": {
        "command": { "type": "string", "enum": ["new-card", "capture", "save-card", "back", "load-card"] },
        "index": { "type": "integer", "minimum": 0, "description": "load-card: index from creator/files" } }, "required": ["command"] } },
    { "method": "POST", "path": "creator/save", "summary": "Save a new card directly (never overwrites; 501 when the game produces no PNG)",
      "body": { "type": "object", "properties": { "file": { "$ref": "CardFile" } }, "required": ["file"] } },
    { "method": "POST", "path": "creator/verify-card", "summary": "Compare a saved card with the character in the maker",
      "body": { "type": "object", "properties": { "file": { "type": "string" } }, "required": ["file"] } },
    { "method": "POST", "path": "creator/load", "summary": "Disabled (501); load cards with creator/native-ui", "deprecated": true }
  ]
}
