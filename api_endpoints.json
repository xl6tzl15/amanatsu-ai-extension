{
  "note": "Single source for every HTTP endpoint. mutates: the call changes game state or files (false = safe to call any time). scene: creator = needs the character creator open, any = works on every screen. GET /api/v1/schema, openapi.yaml (gen_openapi.py) and the MCP server's call_api all read this file; the build fails when it and the C# routes disagree.",
  "components": {
    "Error": { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"] },
    "Color": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "[r,g,b] or [r,g,b,a] in 0..1" },
    "Vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "Vector3Rate": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "Region": { "type": "string", "enum": ["face", "bust", "upper_body", "waist", "legs", "full"] },
    "View": { "type": "string", "enum": ["front", "back", "left", "right", "top", "bottom"] },
    "KitRegion": { "type": "string", "enum": ["outline", "eyes", "brows", "nose", "mouth", "hair"] },
    "CardFile": { "type": "string", "pattern": "^[^/\\\\]+[.]png$", "description": "file name in UserData/chara/female" },
    "ButtonSelector": {
      "type": "object",
      "properties": { "name": { "type": "string", "description": "GameObject name" }, "text": { "type": "string", "description": "label text" },
        "path": { "type": "string", "description": "whole object path or its trailing segments, e.g. Canvas/Menu/Start" },
        "index": { "type": "integer", "minimum": 0, "description": "which match when several buttons match" } },
      "anyOf": [{ "required": ["name"] }, { "required": ["text"] }, { "required": ["path"] }],
      "description": "a visible button matched by every given property (at least one of name, text, path)"
    },
    "WaitResult": {
      "type": "object",
      "properties": {
        "satisfied": { "type": "boolean" }, "elapsedMs": { "type": "integer" }, "frames": { "type": "integer" },
        "state": { "type": "object", "properties": { "scene": { "type": "string" }, "humanCount": { "type": "integer" }, "creatorReady": { "type": "boolean" } } },
        "log": { "type": ["object", "null"], "description": "the debug/log entry that met the log condition" },
        "logCursor": { "type": "integer" },
        "event": { "type": ["object", "null"], "description": "the debug/events entry that met the event condition" },
        "eventCursor": { "type": "integer" },
        "error": { "type": ["string", "null"] } },
      "required": ["satisfied", "elapsedMs", "frames", "state"],
      "description": "debug/wait result"
    },
    "KitApplyResult": {
      "type": "object",
      "properties": {
        "applied": { "$ref": "KitRegion" }, "name": { "type": "string" }, "exclude": { "type": "array", "items": { "type": "string" } },
        "changes": { "type": "array" }, "failures": { "type": "integer" }, "results": { "type": "array" } },
      "required": ["applied", "name", "failures", "results"],
      "description": "creator/kit-apply result; results lists each failed operation with its path, status and body"
    },
    "KitDryRunResult": {
      "type": "object",
      "properties": {
        "dryRun": { "const": true }, "region": { "$ref": "KitRegion" }, "name": { "type": "string" },
        "exclude": { "type": "array", "items": { "type": "string" } }, "changes": { "type": "array" } },
      "required": ["dryRun", "region", "name", "changes"],
      "description": "creator/kit-apply with dryRun: the field changes it would make"
    },
    "Operation": {
      "type": "object",
      "properties": { "path": { "type": "string", "description": "POST endpoint relative to /api/v1/" }, "body": { "type": "object" } },
      "required": ["path", "body"]
    }
  },
  "endpoints": [
    { "method": "GET", "path": "schema", "mutates": false, "scene": "any", "summary": "Every endpoint with its body (this list), followed by the endpoints other plugins registered under ext/" },
    { "method": "GET", "path": "extensions", "mutates": false, "scene": "any", "summary": "Plugins that registered endpoints under ext/{owner}/, and registrations that were rejected with the reason" },
    { "method": "GET", "path": "state", "mutates": false, "scene": "any", "summary": "Scene and whether the character creator is ready" },
    { "method": "POST", "path": "navigate", "mutates": true, "scene": "any", "summary": "One step toward the target screen per call; repeat until done:true",
      "body": { "type": "object", "properties": { "target": { "type": "string", "enum": ["female-creator"] } }, "required": ["target"] } },
    { "method": "GET", "path": "logs", "mutates": false, "scene": "any", "summary": "Recent operation log entries",
      "query": { "limit": { "type": "integer", "minimum": 1, "default": 100 } } },

    { "method": "GET", "path": "debug/plugins", "mutates": false, "scene": "any", "summary": "Loaded BepInEx plugins with GUID, version, DLL path and file time (check that a new build is the one running)" },
    { "method": "GET", "path": "debug/log", "mutates": false, "scene": "any", "summary": "BepInEx log of every plugin and Unity, including lines from before this plugin loaded; pass next back as since to read only new lines",
      "query": { "since": { "type": "integer", "minimum": 0, "default": 0, "description": "cursor from a previous response's next" },
                 "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 },
                 "level": { "type": "string", "enum": ["fatal", "error", "warning", "message", "info", "debug"], "description": "this level and more severe" },
                 "source": { "type": "string", "description": "substring of the log source name" },
                 "contains": { "type": "string", "description": "substring of the message" } } },
    { "method": "GET", "path": "debug/harmony", "mutates": false, "scene": "any", "summary": "Patched methods with every prefix, postfix, transpiler and finalizer and the Harmony id that applied it; shared:true when several owners patch one method",
      "query": { "owner": { "type": "string", "description": "substring of a Harmony owner id or of the patching assembly name" }, "target": { "type": "string", "description": "substring of Type.Method" } } },
    { "method": "GET", "path": "debug/scenes", "mutates": false, "scene": "any", "summary": "Loaded scenes (and DontDestroyOnLoad) with handle, build index and root object count" },
    { "method": "GET", "path": "debug/tree", "mutates": false, "scene": "any", "responses": {"404": "The object or scene was not found"}, "summary": "GameObject hierarchy, depth first, with instance id, active state, child count and component types; page with offset and next",
      "query": { "scene": { "type": "string", "description": "scene name from debug/scenes (default: every loaded scene)" },
                 "id": { "type": "integer", "description": "start at this GameObject or component instead" },
                 "path": { "type": "string", "description": "or at this object path, e.g. CustomScene/UI/Root" },
                 "depth": { "type": "integer", "minimum": 0, "maximum": 64, "default": 3 },
                 "filter": { "type": "string", "description": "only objects whose name or a component type contains this; each result carries its path" },
                 "components": { "type": "boolean", "default": true },
                 "offset": { "type": "integer", "minimum": 0, "default": 0 },
                 "limit": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 200 } } },
    { "method": "GET", "path": "debug/object", "mutates": false, "scene": "any", "responses": {"404": "The object was not found"}, "summary": "One GameObject: path, scene, layer, tag, parent, local and world transform, components with ids, children",
      "query": { "id": { "type": "integer", "description": "GameObject or component instance id" }, "path": { "type": "string" } } },
    { "method": "GET", "path": "debug/component", "mutates": false, "scene": "any", "responses": {"404": "The component, or a field or element on path, was not found"}, "summary": "Field values of one component without calling native getters (only a fixed list of side-effect-free getters); referenced Unity objects are given as ids",
      "query": { "id": { "type": "integer", "required": true, "description": "component instance id from debug/object" },
                 "path": { "type": "string", "description": "field path to look inside, e.g. m_OnClick.m_PersistentCalls.m_Calls[0]" },
                 "depth": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 },
                 "getters": { "type": "boolean", "default": true, "description": "include the side-effect-free getters" } } },
    { "method": "GET", "path": "debug/find", "mutates": false, "scene": "any", "summary": "GameObjects in loaded scenes by component type (exact full or short name) and/or name substring",
      "query": { "type": { "type": "string" }, "name": { "type": "string" },
                 "inactive": { "type": "boolean", "default": true },
                 "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 } } },
    { "method": "GET", "path": "debug/types", "mutates": false, "scene": "any", "responses": {"404": "No type with this full name"}, "summary": "Search game and plugin types by name, or list one type's fields, properties and methods (reflection only; does not wait for the main thread)",
      "query": { "q": { "type": "string", "description": "substring of the full type name (2+ characters)" },
                 "type": { "type": "string", "description": "exact full name: list its members" },
                 "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } } },
    { "method": "GET", "path": "debug/events", "mutates": false, "scene": "any", "summary": "Changes in order: scene_loaded, scene_unloaded, active_scene, humans, creator, root_added, root_removed, log (warnings and errors), api (POST calls), watch, watch_lost; pass next as since",
      "query": { "since": { "type": "integer", "minimum": 0, "default": 0 },
                 "type": { "type": "string", "description": "comma-separated event types" },
                 "contains": { "type": "string", "description": "substring of the event data as JSON" },
                 "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 } } },
    { "method": "POST", "path": "debug/watch", "mutates": false, "scene": "any", "responses": {"404": "The object, component or field was not found"}, "summary": "Read a component field or GameObject property every half second and add a watch event on each change",
      "body": { "type": "object", "properties": {
        "id": { "type": "integer", "description": "component id (with path) or GameObject id (with property)" },
        "path": { "type": "string", "description": "field path as in debug/component" },
        "property": { "type": "string", "enum": ["activeSelf", "activeInHierarchy", "position", "localPosition", "localEulerAngles", "localScale", "name", "childCount"] },
        "objectPath": { "type": "string", "description": "GameObject path instead of id (with property)" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 2, "default": 0 },
        "name": { "type": "string", "description": "label repeated in the events" } } } },
    { "method": "GET", "path": "debug/watches", "mutates": false, "scene": "any", "summary": "Active watches with their last value and number of changes" },
    { "method": "POST", "path": "debug/unwatch", "mutates": false, "scene": "any", "responses": {"404": "No such watch"}, "summary": "Stop a watch",
      "body": { "type": "object", "properties": { "watch": { "type": "integer" }, "all": { "type": "boolean" } } } },
    { "method": "POST", "path": "debug/snapshot", "mutates": false, "scene": "any", "bodyOptional": true, "responses": {"404": "The root object or scene was not found"}, "summary": "Keep the active flags, transforms and component types (and the fields of chosen component types) of a subtree (or a scene, or every scene) for debug/diff",
      "body": { "type": "object", "properties": {
        "id": { "type": "integer" }, "path": { "type": "string" }, "scene": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 64, "default": 64 },
        "fieldTypes": { "type": "string", "description": "also keep the fields of these component types, comma-separated short or full names (e.g. Toggle,Button,TextMeshProUGUI), or * for every component" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 2000, "description": "objects" },
        "name": { "type": "string", "description": "replaces a snapshot of the same name (default snapN)" } } } },
    { "method": "GET", "path": "debug/snapshots", "mutates": false, "scene": "any", "summary": "Kept snapshots" },
    { "method": "POST", "path": "debug/snapshot-delete", "mutates": false, "scene": "any", "responses": {"404": "No such snapshot"}, "summary": "Drop a snapshot",
      "body": { "type": "object", "properties": { "snapshot": { "type": "string" }, "all": { "type": "boolean" } } } },
    { "method": "GET", "path": "debug/diff", "mutates": false, "scene": "any", "responses": {"404": "No such snapshot, or its root no longer exists"}, "summary": "What changed, was added or removed between a snapshot and now (same subtree captured again) or another snapshot",
      "query": { "from": { "type": "string", "required": true }, "to": { "type": "string", "description": "default: capture now" },
                 "contains": { "type": "string", "description": "only keys containing this" },
                 "limit": { "type": "integer", "minimum": 1, "default": 500 } } },
    { "method": "POST", "path": "debug/wait", "mutates": false, "scene": "any", "responses": {"408": {"description": "The conditions did not hold before timeoutMs", "schema": {"$ref": "WaitResult"}}, "200": {"description": "Every condition held", "schema": {"$ref": "WaitResult"}}}, "summary": "Wait until every given condition holds (checked once per frame); 408 with the current state on timeout",
      "body": { "type": "object", "properties": {
        "scene": { "type": "string", "description": "active scene name, e.g. Title, CustomScene, map000" },
        "humanCountAtLeast": { "type": "integer", "minimum": 0 },
        "creatorReady": { "type": "boolean" },
        "button": { "$ref": "ButtonSelector" },
        "log": { "type": "object", "description": "a log line written after the wait started (or after since)", "properties": {
          "contains": { "type": "string" }, "source": { "type": "string" },
          "level": { "type": "string", "enum": ["fatal", "error", "warning", "message", "info", "debug"] }, "since": { "type": "integer" } },
          "anyOf": [{ "required": ["contains"] }, { "required": ["source"] }, { "required": ["level"] }] },
        "event": { "type": "object", "description": "a debug/events entry added after the wait started (or after since)", "properties": {
          "type": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }] }, "contains": { "type": "string" }, "since": { "type": "integer" } },
          "anyOf": [{ "required": ["type"] }, { "required": ["contains"] }] },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 120000, "default": 10000 } },
        "anyOf": [{ "required": ["scene"] }, { "required": ["humanCountAtLeast"] }, { "required": ["creatorReady"] },
                  { "required": ["button"] }, { "required": ["log"] }, { "required": ["event"] }] } },

    { "method": "GET", "path": "ui/buttons", "mutates": false, "scene": "any", "summary": "Active Unity buttons" },
    { "method": "POST", "path": "ui/click", "mutates": true, "scene": "any", "responses": {"404": "No visible button matches, or the id is stale", "409": "Several buttons match, or the button is disabled or hidden, or a scene transition was already requested"}, "summary": "Click a button by id from ui/buttons, or by name/text/path that stays the same between runs (409 lists candidates when several match)",
      "body": { "oneOf": [{ "type": "object", "properties": { "id": { "type": "integer" } }, "required": ["id"] }, { "$ref": "ButtonSelector" }] } },
    { "method": "GET", "path": "ui/toggles", "mutates": false, "scene": "any", "summary": "Active Unity toggles" },
    { "method": "POST", "path": "ui/toggle", "mutates": true, "scene": "any", "responses": {"404": "The toggle id is stale", "409": "The toggle is disabled or hidden"}, "summary": "Set a toggle from ui/toggles",
      "body": { "type": "object", "properties": { "id": { "type": "integer" }, "value": { "type": "boolean" } }, "required": ["id", "value"] } },
    { "method": "GET", "path": "ui/input-sliders", "mutates": false, "scene": "any", "summary": "Maker numeric inputs with their on-screen Japanese label and order" },
    { "method": "POST", "path": "ui/input-slider", "mutates": true, "scene": "any", "responses": {"404": "The input slider id is stale"}, "summary": "Type into a maker numeric input through its real onEndEdit path",
      "body": { "type": "object", "properties": { "id": { "type": "integer" }, "text": { "type": "string" } }, "required": ["id", "text"] } },

    { "method": "GET", "path": "screenshot", "mutates": false, "scene": "any", "responses": {"503": "The screen could not be captured"}, "summary": "Current screen as base64 PNG" },
    { "method": "GET", "path": "camera/landmarks", "mutates": false, "scene": "creator", "summary": "World-space skeleton positions and face bounds" },
    { "method": "POST", "path": "camera/frame", "mutates": true, "scene": "creator", "summary": "Point the maker camera at a body region",
      "body": { "type": "object", "properties": { "region": { "$ref": "Region" }, "view": { "$ref": "View" } }, "required": ["region"] } },
    { "method": "POST", "path": "capture", "mutates": true, "scene": "creator", "summary": "Frame, wait for the render and return framing metadata with image.pngBase64; optional expression and pose apply only for the shot",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "Region" }, "view": { "$ref": "View" },
        "expression": { "type": "object", "properties": { "eyebrow": { "type": "integer", "minimum": 0 }, "eyes": { "type": "integer", "minimum": 0 }, "mouth": { "type": "integer", "minimum": 0 } } },
        "pose": { "oneOf": [{ "type": "string" }, { "type": "integer" }], "description": "state name or index from creator/poses" } },
        "required": ["region"] } },

    { "method": "GET", "path": "character", "mutates": false, "scene": "creator", "summary": "Current character shape arrays and part IDs" },
    { "method": "POST", "path": "character/shape", "mutates": true, "scene": "creator", "summary": "Set one shape value (creator/shapes sets many at once)",
      "body": { "type": "object", "properties": { "region": { "type": "string", "enum": ["body", "face"] }, "index": { "type": "integer", "minimum": 0 }, "value": { "type": "number", "minimum": -5, "maximum": 5 } }, "required": ["region", "index", "value"] } },
    { "method": "POST", "path": "character/choice", "mutates": true, "scene": "creator", "summary": "Choose a head, hair or clothes part by catalog id",
      "body": { "type": "object", "properties": {
        "kind": { "type": "string", "enum": ["head", "hair_back", "hair_front", "hair_side", "hair_option", "clothes_top", "clothes_bot", "clothes_bra", "clothes_shorts", "clothes_gloves", "clothes_panst", "clothes_socks", "clothes_shoes", "clothes_add_arm", "clothes_add_leg", "clothes_add_other"] },
        "id": { "type": "integer" } }, "required": ["kind", "id"] } },
    { "method": "GET", "path": "catalog", "mutates": false, "scene": "creator", "summary": "Choices of a game category sorted by id (bo_head, bo_hair_f, co_bot, ao_*, mt_* ...), including parts other mods add to the game's list; total and more tell whether further pages exist",
      "query": { "category": { "type": "string", "required": true },
                 "offset": { "type": "integer", "minimum": 0, "default": 0 },
                 "limit": { "type": "integer", "minimum": 1, "default": 500 } } },
    { "method": "GET", "path": "cards", "mutates": false, "scene": "any", "summary": "Character cards in UserData/chara/female" },
    { "method": "GET", "path": "card", "mutates": false, "scene": "any", "responses": {"422": "The file is not a readable character card"}, "summary": "Read a saved card without loading it",
      "query": { "file": { "type": "string", "required": true, "description": "relative png path from cards" } } },

    { "method": "GET", "path": "creator/details", "mutates": false, "scene": "creator", "summary": "Profile, named shape indices, colors, coordinate parts, accessory slots and tabs" },
    { "method": "GET", "path": "creator/diagnostics", "mutates": false, "scene": "creator", "summary": "Loaded Human objects" },
    { "method": "GET", "path": "creator/shape-guide", "mutates": false, "scene": "creator", "summary": "Every face/body slider in maker order with its Japanese label and what raising or lowering it does" },
    { "method": "POST", "path": "creator/shapes", "mutates": true, "scene": "creator", "summary": "Set many face/body shape values at once (validated as a whole, one model refresh)",
      "body": { "type": "object", "properties": {
        "face": { "type": "object", "additionalProperties": { "type": "number", "minimum": -5, "maximum": 5 }, "description": "name or index: value" },
        "body": { "type": "object", "additionalProperties": { "type": "number", "minimum": -5, "maximum": 5 }, "description": "name or index: value" } }, "anyOf": [{ "required": ["face"], "properties": { "face": { "minProperties": 1 } } }, { "required": ["body"], "properties": { "body": { "minProperties": 1 } } }] } },
    { "method": "GET", "path": "creator/params", "mutates": false, "scene": "creator", "summary": "Detailed maker values with increase/decrease notes for face and body" },
    { "method": "POST", "path": "creator/params", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Set detailed maker values (all validated first; rolled back if one fails); without values it reads with the given selectors",
      "body": { "type": "object", "properties": {
        "values": { "type": "object", "description": "name: value, names from GET creator/params" },
        "eye": { "type": "integer", "enum": [0, 1] }, "highlight": { "type": "integer", "minimum": 0 },
        "part": { "type": "integer", "minimum": 0, "maximum": 3, "description": "hair 0 back, 1 front, 2 side, 3 option" },
        "slot": { "type": "integer", "minimum": 0, "description": "clothes or accessory slot" },
        "channel": { "type": "integer", "minimum": 0, "description": "clothes colour channel" },
        "foot": { "type": "boolean", "description": "toenails" } } } },
    { "method": "GET", "path": "creator/freeze", "mutates": false, "scene": "creator", "summary": "Whether blinking, eye movement and body motion run" },
    { "method": "POST", "path": "creator/freeze", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Stop (false) or resume (true) blinking, eye movement and body motion; resuming restores the state from before the stop",
      "body": { "type": "object", "properties": { "blink": { "type": "boolean" }, "eyeMovement": { "type": "boolean" }, "motion": { "type": "boolean" } } } },
    { "method": "GET", "path": "creator/face-parts", "mutates": false, "scene": "creator", "summary": "Eyebrow, eyeline, eyelid, eye white, nose, lip line, detail, iris and pupil ids" },
    { "method": "POST", "path": "creator/face-parts", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Change face part ids",
      "body": { "type": "object", "properties": {
        "eyebrow": { "type": "integer" }, "eyelineUp": { "type": "integer" }, "eyelineDown": { "type": "integer" }, "eyelid": { "type": "integer" },
        "white": { "type": "integer" }, "nose": { "type": "integer" }, "lipLine": { "type": "integer" }, "detail": { "type": "integer" },
        "eye": { "type": "integer" }, "pupil": { "type": "integer" }, "eyePreset": { "type": "integer" }, "eyePresetFlags": { "type": "integer", "default": 3 },
        "foregroundEyes": { "type": "integer", "minimum": 0, "maximum": 2 }, "foregroundEyebrow": { "type": "integer", "minimum": 0, "maximum": 2 } } } },
    { "method": "GET", "path": "creator/makeup", "mutates": false, "scene": "creator", "summary": "Eyeshadow, cheek, lip and eye colour makeup" },
    { "method": "POST", "path": "creator/makeup", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Change makeup ids and colours",
      "body": { "type": "object", "properties": {
        "eyeshadowId": { "type": "integer" }, "eyeshadowColor": { "$ref": "Color" }, "cheekId": { "type": "integer" }, "cheekColor": { "$ref": "Color" },
        "cheekHighlightColor": { "$ref": "Color" }, "lipId": { "type": "integer" }, "lipColor": { "$ref": "Color" }, "lipHighlightColor": { "$ref": "Color" },
        "eyeGradColor": { "$ref": "Color" }, "eyeHighlightColor": { "$ref": "Color" } } } },
    { "method": "GET", "path": "creator/eye-lines", "mutates": false, "scene": "creator", "summary": "Eyeline and eyelid colours and eyeline weight" },
    { "method": "POST", "path": "creator/eye-lines", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Change eyeline and eyelid colours and eyeline weight",
      "body": { "type": "object", "properties": { "eyelineColor": { "$ref": "Color" }, "eyelidColor": { "$ref": "Color" }, "eyelineUpWeight": { "type": "number" } } } },
    { "method": "POST", "path": "creator/color", "mutates": true, "scene": "creator", "summary": "Set one hair, eye, eyebrow, clothes or accessory colour",
      "body": { "type": "object", "properties": {
        "target": { "type": "string", "enum": ["hair", "eye", "eyebrow", "clothes", "accessory"] },
        "slot": { "type": "integer", "minimum": 0 }, "channel": { "type": "integer", "minimum": 0 },
        "field": { "type": "string", "enum": ["base", "start", "end", "outline", "gloss", "shadow", "mesh", "inner"], "description": "hair only" },
        "color": { "$ref": "Color" } }, "required": ["target", "color"] } },
    { "method": "POST", "path": "creator/hair-colors", "mutates": true, "scene": "creator", "summary": "Set hair colours on several hair slots at once (default all four)",
      "body": { "type": "object", "properties": {
        "slots": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "base": { "$ref": "Color" }, "start": { "$ref": "Color" }, "end": { "$ref": "Color" }, "outline": { "$ref": "Color" },
        "gloss": { "$ref": "Color" }, "shadow": { "$ref": "Color" }, "mesh": { "$ref": "Color" }, "inner": { "$ref": "Color" },
        "useMesh": { "type": "boolean" }, "useInner": { "type": "boolean" } }, "anyOf": [{ "required": ["base"] }, { "required": ["start"] }, { "required": ["end"] }, { "required": ["outline"] }, { "required": ["gloss"] }, { "required": ["shadow"] }, { "required": ["mesh"] }, { "required": ["inner"] }, { "required": ["useMesh"] }, { "required": ["useInner"] }] } },
    { "method": "POST", "path": "creator/hair-flags", "mutates": true, "scene": "creator", "summary": "Turn a hair slot's mesh and inner colours on or off",
      "body": { "type": "object", "properties": { "slot": { "type": "integer", "minimum": 0, "maximum": 3 }, "useMesh": { "type": "boolean" }, "useInner": { "type": "boolean" } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/hair-bundle", "mutates": true, "scene": "creator", "summary": "Normalized move/rotate rates of one movable bundle of this hairstyle",
      "body": { "type": "object", "properties": {
        "part": { "type": "integer", "minimum": 0, "maximum": 3 }, "index": { "type": "integer", "minimum": 0 },
        "moveRate": { "$ref": "Vector3Rate" }, "rotRate": { "$ref": "Vector3Rate" } }, "required": ["part", "index"],
        "anyOf": [{ "required": ["moveRate"] }, { "required": ["rotRate"] }] } },
    { "method": "POST", "path": "creator/skin", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Skin colour, tan lines, mole and skin shine",
      "body": { "type": "object", "properties": {
        "mainColor": { "$ref": "Color" }, "sunburnUpId": { "type": "integer", "minimum": 0 }, "sunburnDownId": { "type": "integer", "minimum": 0 },
        "moleId": { "type": "integer", "minimum": 0 }, "shineId": { "type": "integer", "minimum": 0 }, "shinePower": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    { "method": "POST", "path": "creator/profile", "mutates": true, "scene": "creator", "summary": "Name, birthday, personality, voice pitch and blood type",
      "body": { "type": "object", "properties": {
        "lastname": { "type": "string", "minLength": 1, "maxLength": 20 }, "firstname": { "type": "string", "minLength": 1, "maxLength": 20 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 20 },
        "birthMonth": { "type": "integer", "minimum": 1, "maximum": 12 }, "birthDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "personality": { "type": "integer", "description": "from creator/personalities" }, "voiceRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "bloodType": { "type": "integer", "minimum": 0, "maximum": 3 } }, "required": ["lastname", "firstname", "nickname"] } },
    { "method": "GET", "path": "creator/personalities", "mutates": false, "scene": "creator", "summary": "Personality ids the maker offers" },
    { "method": "GET", "path": "creator/poses", "mutates": false, "scene": "creator", "summary": "Maker poses usable by capture" },
    { "method": "POST", "path": "creator/accessory", "mutates": true, "scene": "creator", "summary": "Put an accessory in a slot (parent defaults to the accessory's own)",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "category": { "type": "string", "pattern": "^ao_" },
        "id": { "type": "integer", "minimum": 0 }, "parent": { "type": "integer", "minimum": 0 } }, "required": ["slot", "category", "id"] } },
    { "method": "POST", "path": "creator/accessory-move", "mutates": true, "scene": "creator", "summary": "Position, rotation and scale of an accessory's maker tab 01 or 02 (02 only for two-piece accessories)",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "tab": { "type": "integer", "enum": [1, 2], "default": 1 },
        "pos": { "$ref": "Vector3" }, "rot": { "$ref": "Vector3" }, "scl": { "$ref": "Vector3" }, "reset": { "type": "boolean" } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/accessory-clear", "mutates": true, "scene": "creator", "summary": "Empty an accessory slot",
      "body": { "type": "object", "properties": { "slot": { "type": "integer", "minimum": 0 } }, "required": ["slot"] } },
    { "method": "POST", "path": "creator/clothes-pattern", "mutates": true, "scene": "creator", "summary": "Pattern, pattern colour, gloss and metallic of one clothes colour channel",
      "body": { "type": "object", "properties": {
        "slot": { "type": "integer", "minimum": 0 }, "channel": { "type": "integer", "minimum": 0 }, "pattern": { "type": "integer", "minimum": 0 },
        "patternColor": { "$ref": "Color" }, "gloss": { "type": "number", "minimum": 0, "maximum": 1 }, "metallic": { "type": "number", "minimum": 0, "maximum": 1 } },
        "required": ["slot", "channel"] } },
    { "method": "POST", "path": "creator/coordinate", "mutates": true, "scene": "creator", "summary": "Switch the outfit being edited",
      "body": { "type": "object", "properties": { "type": { "type": "integer", "enum": [0, 1], "description": "0 swimsuit, 1 after bath" } }, "required": ["type"] } },
    { "method": "POST", "path": "creator/coordinate-copy", "mutates": true, "scene": "creator", "summary": "Copy hair, accessories, clothes or makeup from one outfit to another",
      "body": { "type": "object", "properties": {
        "from": { "type": "integer", "enum": [0, 1] }, "to": { "type": "integer", "enum": [0, 1] },
        "parts": { "type": "array", "items": { "type": "string", "enum": ["hair", "accessory", "clothes", "makeup"] } } }, "required": ["from", "to"] } },
    { "method": "GET", "path": "creator/camera", "mutates": false, "scene": "creator", "summary": "Maker camera position, rotation, direction and field of view" },
    { "method": "POST", "path": "creator/camera", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Move the maker camera",
      "body": { "type": "object", "properties": {
        "position": { "$ref": "Vector3" }, "rotation": { "$ref": "Vector3" }, "direction": { "$ref": "Vector3" },
        "fov": { "type": "number", "minimum": 5, "maximum": 100 } } } },
    { "method": "POST", "path": "creator/reset", "mutates": true, "scene": "creator", "bodyOptional": true, "summary": "Reset to the maker's initial character",
      "body": { "type": "object", "properties": { "keepProfile": { "type": "boolean" } } } },
    { "method": "GET", "path": "creator/export", "mutates": false, "scene": "creator", "summary": "The whole character as import operations" },
    { "method": "POST", "path": "creator/import", "mutates": true, "scene": "creator", "responses": {"409": "An operation failed and stopOnError was set"}, "summary": "Run POST operations in order with one model refresh at the end",
      "body": { "type": "object", "properties": {
        "operations": { "type": "array", "items": { "$ref": "Operation" } }, "stopOnError": { "type": "boolean", "default": true } }, "required": ["operations"] } },

    { "method": "GET", "path": "creator/kits", "mutates": false, "scene": "creator", "summary": "Saved part kits" },
    { "method": "POST", "path": "creator/kit-save", "mutates": true, "scene": "creator", "summary": "Save one region of the current character as a kit",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "KitRegion" }, "name": { "type": "string" }, "description": { "type": "string" }, "overwrite": { "type": "boolean" } }, "required": ["region", "name"] } },
    { "method": "POST", "path": "creator/kit-from-card", "mutates": true, "scene": "creator", "responses": {"422": "The file is not a readable character card"}, "summary": "Save one region of a saved card as a kit",
      "body": { "type": "object", "properties": {
        "file": { "type": "string" }, "region": { "$ref": "KitRegion" }, "name": { "type": "string" }, "description": { "type": "string" },
        "coordinate": { "type": "integer", "minimum": 0 }, "overwrite": { "type": "boolean" } }, "required": ["file", "region", "name"] } },
    { "method": "POST", "path": "creator/kit-apply", "mutates": true, "scene": "creator", "responses": {"404": "No kit with this region and name", "409": {"description": "One or more of the kit's operations failed; the others were applied", "schema": {"$ref": "KitApplyResult"}}, "200": {"description": "Every operation applied, or with dryRun the changes it would make", "schema": {"oneOf": [{"$ref": "KitApplyResult"}, {"$ref": "KitDryRunResult"}]}}}, "summary": "Apply a kit, optionally leaving out shapes, parts, colours or single fields",
      "body": { "type": "object", "properties": {
        "region": { "$ref": "KitRegion" }, "name": { "type": "string" },
        "exclude": { "type": "array", "items": { "type": "string" }, "description": "shapes, parts, colors or field names" },
        "dryRun": { "type": "boolean" } }, "required": ["region", "name"] } },
    { "method": "POST", "path": "creator/kit-delete", "mutates": true, "scene": "creator", "responses": {"404": "No kit with this region and name"}, "summary": "Delete a kit",
      "body": { "type": "object", "properties": { "region": { "$ref": "KitRegion" }, "name": { "type": "string" } }, "required": ["region", "name"] } },

    { "method": "GET", "path": "creator/files", "mutates": false, "scene": "creator", "summary": "The maker's visible card list (open the native card UI first)" },
    { "method": "POST", "path": "creator/native-ui", "mutates": true, "scene": "creator", "responses": {"409": "The maker's button is not ready"}, "summary": "Press the maker's own save/load buttons",
      "body": { "type": "object", "properties": {
        "command": { "type": "string", "enum": ["new-card", "capture", "save-card", "back", "load-card"] },
        "index": { "type": "integer", "minimum": 0, "description": "load-card: index from creator/files" } }, "required": ["command"] } },
    { "method": "POST", "path": "creator/save", "mutates": true, "scene": "creator", "responses": {"501": "The game produced no PNG card; use the native save workflow"}, "summary": "Save a new card directly (never overwrites; 501 when the game produces no PNG)",
      "body": { "type": "object", "properties": { "file": { "$ref": "CardFile" } }, "required": ["file"] } },
    { "method": "POST", "path": "creator/verify-card", "mutates": false, "scene": "creator", "responses": {"422": "The file is not a readable character card"}, "summary": "Compare a saved card with the character in the maker",
      "body": { "type": "object", "properties": { "file": { "type": "string" } }, "required": ["file"] } },
    { "method": "POST", "path": "creator/load", "mutates": true, "scene": "creator", "responses": {"501": "Card loading through this endpoint is disabled"}, "summary": "Disabled (501); load cards with creator/native-ui", "deprecated": true }
  ]
}
