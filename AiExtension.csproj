<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Amanatsu.AiExtension</AssemblyName>
    <Version>0.10.0</Version>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>../../BepInEx/core/BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>../../BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>../../BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="SemanticVersioning"><HintPath>../../BepInEx/core/SemanticVersioning.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>../../BepInEx/core/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="ILGLib"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/ILGLib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.ScreenCaptureModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>../../BepInEx/interop-AmanatsuLocation/interop/Unity.TextMeshPro.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Source for other plugins to include; not part of this assembly. -->
    <Compile Remove="sdk/**" />
    <EmbeddedResource Include="api_endpoints.json" LogicalName="api_endpoints.json" />
  </ItemGroup>
  <!-- openapi.yaml is generated from api_endpoints.json; a route missing on either side stops the build. -->
  <Target Name="GenerateOpenApi" BeforeTargets="BeforeBuild">
    <Exec Command="python gen_openapi.py" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
